Panels:
  - Class: rviz_common/Displays
    Name: Displays
  - Class: rviz_common/Tool Properties
    Name: Tool Properties
  - Class: rviz_common/Views
    Name: Views
Visualization Manager:
  Class: ""
  Global Options:
    Background Color: 48; 48; 48
    Fixed Frame: map
    Frame Rate: 30
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
      Cell Size: 1
      Plane: XY
      Color: 90; 90; 90
    - Class: rviz_default_plugins/Map
      Name: Map
      Enabled: true
      Alpha: 1
      Color Scheme: map
      Topic:
        Value: /map
        Reliability Policy: Reliable
        Durability Policy: Transient Local
        History Policy: Keep Last
        Depth: 1
    - Class: rviz_default_plugins/Map
      Name: Robot Clearance
      Enabled: false
      Alpha: 0.35
      Color Scheme: costmap
      Topic:
        Value: /astar_costmap
        Reliability Policy: Reliable
        Durability Policy: Transient Local
        Depth: 1
    - Class: rviz_default_plugins/RobotModel
      Name: Robot
      Enabled: true
      Description Source: Topic
      Description Topic:
        Value: /robot_description
        Reliability Policy: Reliable
        Durability Policy: Transient Local
        Depth: 1
      Visual Enabled: true
      Collision Enabled: false
    - Class: rviz_default_plugins/LaserScan
      Name: LaserScan
      Enabled: true
      Style: Points
      Size (Pixels): 3
      Topic:
        Value: /scan
        Reliability Policy: Best Effort
        Durability Policy: Volatile
        Depth: 5
    - Class: rviz_default_plugins/Path
      Name: A Star Path
      Enabled: true
      Color: 0; 220; 255
      Alpha: 1
      Line Style: Lines
      Line Width: 0.03
      Pose Style: None
      Topic:
        Value: /astar_path
        Reliability Policy: Reliable
        Durability Policy: Transient Local
        Depth: 1
    - Class: rviz_default_plugins/Image
      Name: YOLO Camera
      Enabled: true
      Topic:
        Value: /yolo/image
        Reliability Policy: Best Effort
        Durability Policy: Volatile
        History Policy: Keep Last
        Depth: 1
      Transport Hint: raw
      Normalize Range: true
  Tools:
    - Class: rviz_default_plugins/Interact
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
    - Class: rviz_default_plugins/SetInitialPose
      Topic:
        Value: /initialpose
        Reliability Policy: Reliable
        Durability Policy: Volatile
        Depth: 5
      X std deviation: 0.15
      Y std deviation: 0.15
      Theta std deviation: 0.15
    - Class: rviz_default_plugins/SetGoal
      Topic:
        Value: /goal_pose
        Reliability Policy: Reliable
        Durability Policy: Volatile
        Depth: 5
  Views:
    Current:
      Class: rviz_default_plugins/TopDownOrtho
      Name: Current View
      Scale: 100
      X: 0
      Y: 0
      Angle: 0
      Target Frame: map
Window Geometry:
  Width: 1200
  Height: 850
